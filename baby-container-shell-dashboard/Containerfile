FROM docker.io/library/python@sha256:aa679aa4eed6eb56c1dc6ad3f1b98b7d2d788fd961596779d188fdedad97fb38

RUN apk add --no-cache openssh-client sshpass

WORKDIR /app
COPY dashboard.py .

ENV DASHBOARD_PORT=3000
ENV BABY_SLOT=ssh-shell
ENV BABY_INSTANCE_ID=ssh-shell-1
ENV BABY_SSH_HOST=127.0.0.1
ENV BABY_SSH_PORT=2222
ENV BABY_TEST_PASSWORD=atakit-test
ENV PORTAL_SOCKET=/run/atakit-portal.sock
ENV UPLOAD_SPOOL_DIR=/var/lib/shell-dashboard/uploads

EXPOSE 3000 2222
CMD ["python", "dashboard.py"]
